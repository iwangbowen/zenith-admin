# Zenith Admin — Docker Compose 环境变量模板
#
# 使用方法：
#   cp .env.docker .env
#   npm run secret:generate -- --docker   # 一次生成下面四个必填项，粘贴进 .env
#
# 注意：.env 文件已在 .gitignore 中，不要提交到版本控制。

# ─── 安全（必填，无默认值；留空时 docker compose up 直接报错）────────────────
# JWT_SECRET            用于签发 JWT（≥ 32 字符随机），按服务实例独立
# FIELD_ENCRYPTION_KEY  字段级 AES-256-GCM 密钥（64 位 hex），按数据库共享；轮换会使已入库密文不可读
# POSTGRES_PASSWORD     PostgreSQL 口令（仅 compose 内网可达，但仍不允许弱口令 / 默认值）
# REDIS_PASSWORD        Redis 口令（Redis 承载会话 / 限流 / 验证码，始终 requirepass）；
#                       会被拼进 REDIS_URL，只能使用 URL 安全字符（生成器输出即满足）
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
# 使用外部 Redis 时整体覆盖连接串（默认 redis://:${REDIS_PASSWORD}@redis:6379/0）
# REDIS_URL=redis://:your_password@redis.example.com:6379/0

# ─── 端口映射 ─────────────────────────────────────────────────────────────────
# 前端 Nginx 对外端口（默认 80）；API 与 WebSocket 经 Nginx 同源代理 /api
WEB_PORT=80
# API 端口默认只绑定宿主机回环 127.0.0.1；确需直接对外暴露时设置 API_BIND=0.0.0.0
API_PORT=3300
# API_BIND=127.0.0.1
# PostgreSQL / Redis 默认不映射宿主机端口；本机排障叠加 docker-compose.debug.yml（绑定 127.0.0.1），
# 端口可用 POSTGRES_PORT / REDIS_PORT 调整
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ─── CORS / 安全 ──────────────────────────────────────────────────────────────
# 生产环境强烈建议设置为实际域名，防止 CSRF
# CORS_ORIGIN=https://admin.example.com
# ALLOWED_ORIGINS=https://admin.example.com

# ─── 进程角色与扩容 ──────────────────────────────────────────────────────────
# compose 默认拆分部署：api 服务 ZENITH_ROLES=api（HTTP / WS，只投递作业），worker 服务 ZENITH_ROLES=worker（执行作业）。
# 横向扩容：docker compose up -d --scale api=2 --scale worker=3
# 单容器全量：docker compose -f docker-compose.yml -f docker-compose.single.yml up -d
# worker 停机排空在飞作业的预算（毫秒，缺省 120000；compose 的 stop_grace_period 为 130s，改大时同步调整）
# WORKER_SHUTDOWN_GRACE_MS=120000

# ─── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── OAuth（可选）────────────────────────────────────────────────────────────
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAuth 回调基础 URL，需与前端部署地址一致
OAUTH_CALLBACK_BASE_URL=http://localhost

# ─── 镜像标签 ────────────────────────────────────────────────────────────────
# 用于标记构建的 Docker 镜像版本（默认 latest）
# TAG=0.18.0

# ─── PDF 导出字体（构建参数，改后需 docker compose build）───────────────────
# subset（默认）：内置 Noto Sans SC 子集，约 2.5MB，覆盖 GB 2312 ∪《通用规范汉字表》8230 字与常用符号
# full：全量 Noto Sans SC，约 8MB，另含繁体 / 日韩汉字 / 生僻字；报表或审批单常含这类字符时选它
# 企业自有字体：挂载进容器后用 REPORT_PDF_FONT_PATH 指定，优先级高于两者
# PDF_FONT=subset