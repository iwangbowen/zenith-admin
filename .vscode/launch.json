{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Server",
      "runtimeExecutable": "npm",
      "args": ["run", "dev:server"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Server (api role)",
      "runtimeExecutable": "npm",
      "args": ["run", "dev:server"],
      "cwd": "${workspaceFolder}",
      "env": { "ZENITH_ROLES": "api" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Worker",
      "runtimeExecutable": "npx",
      "args": ["tsx", "watch", "--exclude", "storage/**", "--exclude", "logs/**", "src/index.ts"],
      "cwd": "${workspaceFolder}/packages/server",
      "env": { "NODE_ENV": "development", "ZENITH_ROLES": "worker" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: Web",
      "runtimeExecutable": "npm",
      "args": ["run", "dev", "-w", "@zenith/web"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Mastra Studio",
      "runtimeExecutable": "npm",
      "args": ["run", "dev:studio"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug: Full Stack",
      "configurations": ["Debug: Server", "Debug: Web"],
      "stopAll": true
    },
    {
      "name": "Debug: Full Stack + Studio",
      "configurations": ["Debug: Server", "Debug: Web", "Mastra Studio"],
      "stopAll": true
    },
    {
      "name": "Debug: Split (api + worker + Web)",
      "configurations": ["Debug: Server (api role)", "Debug: Worker", "Debug: Web"],
      "stopAll": true
    }
  ]
}
