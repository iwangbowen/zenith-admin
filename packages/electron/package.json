{
  "name": "@zenith/electron",
  "version": "2.19.0",
  "private": true,
  "description": "Zenith Admin Electron Client",
  "author": "Zenith Admin",
  "repository": {
    "type": "git",
    "url": "https://github.com/iwangbowen/zenith-admin.git"
  },
  "main": "dist/main.js",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "scripts": {
    "dev": "tsc && concurrently \"npm run dev -w @zenith/web\" \"tsc --watch --preserveWatchOutput\" \"wait-on http://localhost:5373 && electron .\"",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "build:mac": "tsc && electron-builder --mac",
    "build:linux": "tsc && electron-builder --linux"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wait-on": "^9.1.0"
  }
}
