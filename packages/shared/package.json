{
	"name": "@zenith/shared",
	"version": "2.18.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "tsc && tsc-alias --resolve-full-paths",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./core": "./src/core/index.ts",
		"./identity": "./src/identity/index.ts",
		"./platform": "./src/platform/index.ts",
		"./messaging": "./src/messaging/index.ts",
		"./workflow": "./src/workflow/index.ts",
		"./payment": "./src/payment/index.ts",
		"./member": "./src/member/index.ts",
		"./report": "./src/report/index.ts",
		"./analytics": "./src/analytics/index.ts",
		"./ai": "./src/ai/index.ts",
		"./chat": "./src/chat/index.ts",
		"./mp": "./src/mp/index.ts",
		"./cms": "./src/cms/index.ts",
		"./open-platform": "./src/open-platform/index.ts",
		"./rules": "./src/rules/index.ts",
		"./ops": "./src/ops/index.ts",
		"./tasks": "./src/tasks/index.ts",
		"./biz": "./src/biz/index.ts",
		"./wiki": "./src/wiki/index.ts",
		"./short-link": "./src/short-link/index.ts",
		"./marketing": "./src/marketing/index.ts",
		"./iot": "./src/iot/index.ts",
		"./drive": "./src/drive/index.ts",
		"./settings": "./src/settings/index.ts",
		"./licensing": "./src/licensing/index.ts",
		"./seed": "./src/seed/index.ts",
		"./seed/*": "./src/seed/*.ts",
		"./*": "./src/*.ts"
	},
	"dependencies": {
		"dayjs": "^1.11.23",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"tsc-alias": "^1.9.2",
		"vitest": "^5.0.0"
	}
}
