import '@hono/zod-openapi';
import { eq } from 'drizzle-orm';
import { mkdir, readFile, writeFile, rm } from 'node:fs/promises';
import { resolve, join } from 'node:path';
import { db, closeDb } from '../src/db';
import { config } from '../src/config';
import { managedFiles, fileStorageConfigs } from '../src/db/schema';
import { runManagedFileGc } from '../src/services/files/file-gc.service';
import { closeRedis } from '../src/lib/redis';
if (!['localhost', '127.0.0.1', '[::1]'].includes(new URL(config.databaseUrl).hostname) || new URL(config.databaseUrl).pathname !== '/zenith_export_qa') throw new Error('Requires isolated export QA DB');
const out = resolve('../../output/export-special');
const fixture = JSON.parse(await readFile(join(out, 'runtime-initial.json'), 'utf8'));
const root = join(out, 'gc-root'); await mkdir(root, { recursive: true });
const [cfg] = await db.insert(fileStorageConfigs).values({ name: 'QA GC fault', provider: 'local', localRootPath: root }).returning();
await mkdir(join(root, 'object.csv')); await writeFile(join(root, 'object.csv', 'child'), 'forces unlink failure');
const [file] = await db.insert(managedFiles).values({ storageConfigId: cfg.id, storageName: cfg.name, provider: 'local', originalName: 'object.csv', objectKey: 'object.csv', size: 27, visibility: 'restricted', gcState: 'orphan', refCount: 0, orphanedAt: new Date(Date.now() - 48 * 3600000), tenantId: fixture.tenantA }).returning();
await runManagedFileGc(0);
const failed = await db.query.managedFiles.findFirst({ where: eq(managedFiles.id, file.id) });
if (failed?.gcState !== 'deleting') throw new Error('Missing durable delete tombstone');
await rm(join(root, 'object.csv'), { recursive: true }); await writeFile(join(root, 'object.csv'), 'recovered');
await runManagedFileGc(0);
const recovered = await db.query.managedFiles.findFirst({ where: eq(managedFiles.id, file.id) });
if (recovered) throw new Error('GC did not retry deletion');
await writeFile(join(out, 'gc-recovery.json'), JSON.stringify({ failedState: failed.gcState, recoveredDeleted: true }, null, 2));
process.stdout.write(JSON.stringify({ failedState: failed.gcState, recoveredDeleted: true }) + '\n');
await closeDb(); await closeRedis(); process.exit(0);
