import '@hono/zod-openapi';
import { eq } from 'drizzle-orm';
import { readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { config } from '../src/config';
import { db, closeDb } from '../src/db';
import * as schema from '../src/db/schema';
import { registerExport } from '../src/lib/export-center/registry';
import { reportPrintExportDefinition } from '../src/services/report/exports/report-print';
import { workflowApprovalSheetsExportDefinition } from '../src/services/workflow/exports/workflow-approval-sheets';
import { createExportJob, getExportJobDownload } from '../src/services/tasks/export-jobs.service';
import { runWithCurrentUser, runWithOperationPermissions } from '../src/lib/context';
import { runWithFreshUserPermissions } from '../src/lib/permissions';
import { closeRedis } from '../src/lib/redis';
import { registerWorkflowIntegrations } from '../src/bootstrap/workflow-business-adapters';
if (!['localhost', '127.0.0.1', '[::1]'].includes(new URL(config.databaseUrl).hostname) || new URL(config.databaseUrl).pathname !== '/zenith_export_qa') throw new Error('Requires isolated export QA DB');
const out = resolve('../../output/export-special');
const fixture = JSON.parse(await readFile(resolve(out, 'runtime-initial.json'), 'utf8'));
const actor = { userId: fixture.actor, username: 'exportqa-a-owner', tenantId: fixture.tenantA, roles: ['exportqa-exporter'] };
await db.update(schema.roles).set({ permissionCodes: ['system:user:export', 'report:print:list', 'workflow:instance:print'] }).where(eq(schema.roles.code, 'exportqa-exporter'));
const execute = <T>(fn: () => Promise<T>) => runWithCurrentUser(actor, () => runWithOperationPermissions(['report:print:list'], () => runWithFreshUserPermissions(actor.userId, fn)));
const [template] = await db.insert(schema.reportPrintTemplates).values({ name: 'Export ACL proof ' + Date.now(), tenantId: fixture.tenantA, ownerId: fixture.peer, content: { grid: { rows: 2, cols: 2, cells: [{ row: 0, col: 0, v: '受保护报表' }, { row: 1, col: 0, v: '撤权后禁止下载' }] } } }).returning();
const [acl] = await db.insert(schema.reportResourceAcls).values({ tenantId: fixture.tenantA, resourceType: 'print_template', resourceId: template.id, subjectType: 'user', subjectId: actor.userId, role: 'viewer' }).returning();
registerExport(reportPrintExportDefinition);
const job = await execute(() => createExportJob({ entity: 'report.print', format: 'pdf', query: { templateId: template.id }, executionMode: 'sync' }));
const file = await execute(() => getExportJobDownload(job.job.id, {}));
await writeFile(resolve(out, 'documents/protected-report.pdf'), Buffer.from(await new Response(file.stream).arrayBuffer()));
await db.delete(schema.reportResourceAcls).where(eq(schema.reportResourceAcls.id, acl.id));
let status;
try { await execute(() => getExportJobDownload(job.job.id, {})); throw new Error('ACL revoked but download allowed'); } catch (error) { status = (error as {status?:number}).status; if (status !== 403) throw error; }
await writeFile(resolve(out, 'resource-revocation.json'), JSON.stringify({ templateId: template.id, jobId: job.job.id, before: 'downloaded', after: status }, null, 2));
process.stdout.write(JSON.stringify({ jobId: job.job.id, revokedDownloadStatus: status }) + '\n');
const [definition] = await db.insert(schema.workflowDefinitions).values({ name: 'QA approval proof', tenantId: fixture.tenantA, status: 'published', flowData: { nodes: [], edges: [] } }).returning();
const [instance] = await db.insert(schema.workflowInstances).values({ definitionId: definition.id, definitionSnapshot: { name: definition.name, flowData: { nodes: [], edges: [] } } as typeof schema.workflowInstances.$inferInsert.definitionSnapshot, formSnapshot: { version: 1, formType: 'designer', fields: [{ key: 'purpose', type: 'input', label: '用途' }] } as typeof schema.workflowInstances.$inferInsert.formSnapshot, title: '专项审批单', tenantId: fixture.tenantA, initiatorId: actor.userId, status: 'approved', formData: { purpose: '专项验收中文内容' } }).returning();
registerExport(workflowApprovalSheetsExportDefinition);
registerWorkflowIntegrations();
const approval = await execute(() => createExportJob({ entity: 'workflow.approval-sheets', format: 'pdf', query: { instanceIds: [instance.id] }, executionMode: 'sync' }));
const approvalFile = await execute(() => getExportJobDownload(approval.job.id, {}));
await writeFile(resolve(out, 'documents/approval.pdf'), Buffer.from(await new Response(approvalFile.stream).arrayBuffer()));
await db.update(schema.workflowInstances).set({ initiatorId: fixture.peer }).where(eq(schema.workflowInstances.id, instance.id));
let approvalRevoked;
try { await execute(() => getExportJobDownload(approval.job.id, {})); throw new Error('Workflow revoked but file allowed'); } catch (error) { approvalRevoked = (error as {status?:number}).status; if (approvalRevoked !== 403) throw error; }
await writeFile(resolve(out, 'approval-revocation.json'), JSON.stringify({ jobId: approval.job.id, instanceId: instance.id, status: approvalRevoked }, null, 2));
process.stdout.write(JSON.stringify({ approvalJob: approval.job.id, approvalRevoked }) + '\n');
await closeDb(); await closeRedis(); process.exit(0);
