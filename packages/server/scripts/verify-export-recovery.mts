import '@hono/zod-openapi';
import { spawn } from 'node:child_process';
import { setTimeout } from 'node:timers/promises';
import { readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { eq } from 'drizzle-orm';
import { config } from '../src/config';
import { db, closeDb } from '../src/db';
import { asyncTasks, exportJobs, fileStorageConfigs } from '../src/db/schema';
import { registerExport, defineExport } from '../src/lib/export-center/registry';
import { runWithCurrentUser, runWithOperationPermissions } from '../src/lib/context';
import { createExportJob, registerExportJobWorker, cancelExportJob } from '../src/services/tasks/export-jobs.service';
import { drainAsyncTasks } from '../src/lib/task-center';
import { closeRedis } from '../src/lib/redis';
if (!['localhost', '127.0.0.1', '[::1]'].includes(new URL(config.databaseUrl).hostname) || new URL(config.databaseUrl).pathname !== '/zenith_export_qa') throw new Error('Requires isolated export QA DB');
const out = resolve('../../output/export-special');
const fixture = JSON.parse(await readFile(resolve(out, 'runtime-initial.json'), 'utf8'));
const actor = { userId: fixture.actor, username: 'exportqa-a-owner', tenantId: fixture.tenantA, roles: ['exportqa-exporter'] };
const asActor = <T>(fn: () => Promise<T>) => runWithCurrentUser(actor, () => runWithOperationPermissions(['system:user:export'], fn));
registerExport(defineExport({ entity: 'qa.slow', moduleName: 'QA', filenamePrefix: 'QA-slow', permissions: { export: 'system:user:export' }, columns: [{ key: 'id', header: 'ID' }, { key: 'text', header: '内容' }], countRows: async () => 5000, streamRows: async () => [] }));
registerExportJobWorker();
await db.update(fileStorageConfigs).set({ provider: 'local' });
await db.update(asyncTasks).set({ status: 'cancelled', completedAt: new Date() }).where(eq(asyncTasks.status, 'pending'));
const records = [];
const worker = (id: number) => spawn(process.execPath, ['--import', 'tsx', 'scripts/export-special-worker.mts', String(id)], { env: process.env, stdio: 'ignore', windowsHide: true });
async function waitFor(check: () => Promise<boolean>, budget = 30000) { const end = Date.now() + budget; while (Date.now() < end) { if (await check()) return; await setTimeout(50); } throw new Error('Timed out'); }
const job = await asActor(() => createExportJob({ entity: 'qa.slow', format: 'csv', query: {}, executionMode: 'async' }));
const first = worker(job.job.taskId!);
await waitFor(async () => ((await db.query.exportJobs.findFirst({ where: eq(exportJobs.id, job.job.id) }))?.processedRows ?? 0) >= 250);
const prior = (await db.query.asyncTasks.findFirst({ where: eq(asyncTasks.id, job.job.taskId!) }))!;
first.kill('SIGKILL'); await new Promise<void>(resolve => first.once('exit', () => resolve()));
await db.update(asyncTasks).set({ heartbeatAt: new Date(Date.now() - 120000) }).where(eq(asyncTasks.id, prior.id));
await drainAsyncTasks();
const recovered = (await db.query.asyncTasks.findFirst({ where: eq(asyncTasks.id, prior.id) }))!;
if (recovered.status !== 'pending' || recovered.dispatchToken === prior.dispatchToken) throw new Error('No fenced recovery');
const replacement = worker(prior.id);
await new Promise<void>((resolve, reject) => replacement.once('exit', code => code === 0 ? resolve() : reject(new Error('Replacement worker failed ' + code))));
const complete = (await db.query.exportJobs.findFirst({ where: eq(exportJobs.id, job.job.id) }))!;
const completedTask = (await db.query.asyncTasks.findFirst({ where: eq(asyncTasks.id, prior.id) }))!;
if (complete.status !== 'success' || complete.rowCount !== 5000 || completedTask.attempts !== 2) throw new Error('Incomplete recovery');
records.push({ name: 'killed-worker-recovery', jobId: complete.id, originalPid: first.pid, replacementPid: replacement.pid, oldToken: prior.dispatchToken, newToken: recovered.dispatchToken, attempts: completedTask.attempts, rows: complete.rowCount, status: complete.status });
const cancel = await asActor(() => createExportJob({ entity: 'qa.slow', format: 'xlsx', query: {}, executionMode: 'async' }));
const running = worker(cancel.job.taskId!);
await waitFor(async () => ((await db.query.exportJobs.findFirst({ where: eq(exportJobs.id, cancel.job.id) }))?.processedRows ?? 0) >= 250);
await asActor(() => cancelExportJob(cancel.job.id));
await new Promise<void>((resolve, reject) => running.once('exit', code => code === 0 ? resolve() : reject(new Error('Cancel worker failed ' + code))));
const cancelled = (await db.query.exportJobs.findFirst({ where: eq(exportJobs.id, cancel.job.id) }))!;
if (cancelled.status !== 'cancelled' || cancelled.fileId) throw new Error('Cancellation published a file');
records.push({ name: 'running-cancel', status: cancelled.status, rowsProcessed: cancelled.processedRows, fileId: cancelled.fileId });
await writeFile(resolve(out, 'recovery-checks.json'), JSON.stringify(records, null, 2));
process.stdout.write(JSON.stringify(records) + '\n');
await setTimeout(500); await closeDb(); await closeRedis(); process.exit(0);
