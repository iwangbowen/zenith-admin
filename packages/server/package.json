  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:split": "node scripts/dev.mjs --split",
    "build": "tsc && tsc-alias --resolve-full-paths && node scripts/copy-theme-assets.mjs && node scripts/build-islands.mjs && node scripts/write-cms-render-fingerprint.mjs && node scripts/build-pdf-font.mjs",
    "build:pdf-font": "node scripts/build-pdf-font.mjs",
    "package": "node scripts/package-server.mjs",
    "start": "node dist/index.js",
    "start:migrate": "node dist/db/migrate.js",
    "verify:split": "node scripts/verify-split.mjs",
    "verify:numbering": "tsx scripts/verify-numbering.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "secret:generate": "tsx scripts/generate-secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src && tsc -p tsconfig.typecheck.json && tsc -p tsconfig.islands.json",
    "typecheck:contracts": "tsc -p tsconfig.typecheck.json",
    "lint:fix": "eslint src --fix"
