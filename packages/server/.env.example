# ─── 服务器 ──────────────────────────────────────────────────────────────────
PORT=3300
# 运行模式：npm run dev 自动注入 development（解锁内置开发密钥、短信验证码回传等联调便利）；
# 生产 / 预发等其他部署方式请显式设置为 production（Docker Compose 已设置）
# NODE_ENV=production

# ─── 认证与加密密钥 ───────────────────────────────────────────────────────────
# 本地开发（npm run dev）留空即可：自动使用内置开发密钥，连同一个开发库的同事无需交换密钥。
# 其他环境（含未设置 NODE_ENV）必填且无默认值，缺失 / 占位值会在启动时被拒绝。
# 生成：npm run secret:generate（JWT_SECRET ≥ 32 字符随机；FIELD_ENCRYPTION_KEY 64 位 hex）
#   JWT_SECRET            按服务实例独立，轮换只需全员重新登录
#   FIELD_ENCRYPTION_KEY  按数据库共享（连同一个库的实例必须一致），轮换会使已入库密文不可读
# JWT_SECRET=
# FIELD_ENCRYPTION_KEY=

# ─── 数据库（PostgreSQL ≥ 15）────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zenith_admin
# 运行时设置进程内副本的兜底 TTL（毫秒，默认 30000）。新鲜度主要靠 PG LISTEN/NOTIFY 失效广播；
# 经 pgBouncer 事务池等无法透传 NOTIFY 的连接池部署时，跨实例陈旧窗口 ≈ 该值。
# SETTINGS_CACHE_TTL_MS=30000

# ─── Redis（会话持久化）────────────────────────────────────────────────────────
# 方式一：URL 格式（推荐，支持带密码的连接）
REDIS_URL=redis://127.0.0.1:6379
# 带密码示例：
# REDIS_URL=redis://:your_password@127.0.0.1:6379/0

# 方式二：逐项配置（与 REDIS_URL 二选一，REDIS_URL 优先）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=zenith:   # 所有 Redis key 的命名空间前缀（默认 zenith:）

# ─── 开放平台 ────────────────────────────────────────────────────────────────
# Redis 限流检查异常时是否拒绝开放 API 请求。生产环境建议保持 true。
OPEN_RATE_LIMIT_FAIL_CLOSED=true
# 开放 API 原始调用日志保留天数；每日聚合统计长期保留。
# Webhook 连续终态失败达到该次数后自动停用订阅并通知应用负责人。
OPEN_WEBHOOK_AUTO_DISABLE_FAILURES=5
# 应用密钥轮换时旧密钥的并行有效时长。
OPEN_SECRET_ROTATION_GRACE_HOURS=24
# 开启后，仅审核通过的应用可使用 OAuth2 与开放 API 网关。
OPEN_GATEWAY_REQUIRE_APPROVAL=true
# API 调试台访问本机开放网关的地址；留空使用 http://127.0.0.1:${PORT}。
OPEN_API_INTERNAL_BASE_URL=

# ─── 日志 ────────────────────────────────────────────────────────────────────
# 级别：fatal / error / warn / info / debug / trace
LOG_LEVEL=info
LOG_DIR=logs
# 日志查看器允许读取的目录白名单（逗号分隔绝对路径）；LOG_DIR 始终允许，非 Windows 默认额外允许 /var/log。
# 白名单外的路径一律拒绝，避免持有 system:log:view 的用户读取服务器任意文件（.env、密钥等）
# LOG_VIEWER_ROOTS=/var/log,/opt/app/logs
# 轮转日志文件保留份数（按天轮转，1 份 = 1 天）
LOG_MAX_FILES=30
# 控制台输出 pino-pretty 彩色单行（本地开发建议 true）；默认 false 输出 NDJSON。
# 只影响控制台，日志文件始终 NDJSON
LOG_CONSOLE_PRETTY=false

# ─── 运行环境 ──────────────────────────────────────────────────────────────────
# 设置为 true 时，每个响应会附加 Server-Timing 头，可在 Chrome DevTools → Network → Timing 查看各阶段耗时
# 建议生产环境设为 false，避免暴露内部性能信息
SERVER_TIMING_ENABLED=false

# ─── 可观测性（Prometheus / OpenTelemetry）───────────────────────────────────
# Prometheus 指标默认暴露在 GET /metrics，无需额外配置。
# OpenTelemetry tracing：
# - OTEL_ENABLED=true 时强制启用
# - 若未显式设置 OTEL_ENABLED，但配置了 OTLP endpoint，也会自动启用
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zenith-admin-server
# 可选：未设置时默认读取当前 npm package version
# OTEL_SERVICE_VERSION=0.5.0

# 可选：OTLP traces 专用 HTTP 导出地址（推荐）
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# 可选：通用 OTLP 端点（未设置 traces endpoint 时使用）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# 可选：OTLP 导出请求头，逗号分隔。
# 示例：OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xxx,x-honeycomb-team=xxx
# OTEL_EXPORTER_OTLP_HEADERS=

# ─── 请求限制 ──────────────────────────────────────────────────────────────────
# 请求体大小限制（单位：字节）。0 或未设置 = 不限制（使用运行时默认）
# 建议：普通 10MB=10485760；允许大文件上传设为 104857600（100MB）或更大
REQUEST_BODY_LIMIT=0

# 请求超时（单位：毫秒）。0 或未设置 = 不启用超时中间件
# 启用后自动排除：/api/ws、/api/files、/api/db-backups 及所有 /export 接口
REQUEST_TIMEOUT_MS=0

# ─── 安全 ────────────────────────────────────────────────────────────────────
# CSRF 允许的来源白名单，逗号分隔。留空 = 开发模式不限制来源
# 生产环境强烈建议配置，防止跨站请求伪造（CSRF）攻击
# 示例：ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
ALLOWED_ORIGINS=

# 仅当 TCP 对端位于以下受信代理 CIDR 时，才读取 X-Forwarded-For / X-Real-IP。
# 示例：TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXY_CIDRS=

# 报表 API/Webhook/外部数据库默认禁止访问 localhost、私网及保留地址。
# 确需连接可信内网数据源时，显式配置主机名、IP 或 CIDR，逗号分隔。
# 示例：REPORT_OUTBOUND_PRIVATE_ALLOWLIST=db.internal,10.20.0.0/16
REPORT_OUTBOUND_PRIVATE_ALLOWLIST=

# AI 服务商出站请求（聊天流/连接测试/模型发现/embedding）默认禁止访问私网及保留地址。
# 本地部署模型（如 Ollama）等可信内网地址可在此放行，逗号分隔（主机名/IP/CIDR）。
# 默认：127.0.0.1,localhost
# 示例：AI_OUTBOUND_PRIVATE_ALLOWLIST=127.0.0.1,localhost,ollama.internal
AI_OUTBOUND_PRIVATE_ALLOWLIST=127.0.0.1,localhost

# 开发环境放开 /api/mastra 鉴权，Mastra Studio 免配置 Authorization 头即可连接。
# NODE_ENV=production 时该开关强制忽略（生产始终要求登录 + ai:studio:access 权限）。
MASTRA_STUDIO_ALLOW_ANONYMOUS=false

# PDF 打印包含中文时必须提供可用的 CJK 字体；未配置时会探测常见系统字体。
# REPORT_PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
REPORT_PDF_FONT_PATH=

# ─── WebRTC 音视频通话 ────────────────────────────────────────────────────────
# 聊天模块的 1v1 / 群语音 / 视频通话信令复用 /api/ws，媒体走 P2P。
# 浏览器创建 RTCPeerConnection 时使用的 ICE 服务器（STUN/TURN）由本段决定，
# 通过 GET /api/chat/rtc/config 下发给前端。
#
# STUN 用于发现公网地址（多地址逗号分隔）；默认公共 STUN 可满足同 LAN/本机连通。
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
#
# ⚠️ 跨 NAT / 公网通话必须配置 TURN 中继，否则双方无法穿透时通话会失败。
# 可自建 coturn 或使用云服务商提供的 TURN。多地址逗号分隔。
# 示例：
# WEBRTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# WEBRTC_TURN_USERNAME=zenith
# WEBRTC_TURN_CREDENTIAL=your_turn_password
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ─── HTTP 流量日志（对标 Zalando Logbook）────────────────────────────────────
#
# 入站（Incoming）：记录进入本系统的 HTTP 请求/响应
# 出站（Outgoing）：记录本系统通过 http-client.ts 发出的外部请求
#
# 级别说明（从低到高）：
#   off     - 不记录任何内容
#   access  - 仅记录方法/URL/状态码/耗时（最轻量，无 body 开销）
#   headers - access + 请求/响应 Headers
#   body    - access + 请求/响应 Body
#   full    - 全量（access + headers + body）
#
# 格式：
#   json    - 结构化 NDJSON（推荐，适合 ELK / Grafana）
#   text    - 多行人类可读格式（适合开发调试）
#   curl    - 请求阶段生成可重放的 curl 命令（适合复现问题）

# ── 入站日志 ──────────────────────────────────────────────────────────────────
# 全局开关（默认关闭，按需开启）
HTTP_LOG_INCOMING_ENABLED=false

# 默认记录级别（未被方法级别覆盖时生效）
HTTP_LOG_INCOMING_LEVEL=access

# 方法级别覆盖（可精细控制每类 HTTP 方法的记录详细度）
# HTTP_LOG_INCOMING_METHOD_GET=off       # GET 查询类通常不需要 body
# HTTP_LOG_INCOMING_METHOD_POST=full     # POST 写接口全量记录
# HTTP_LOG_INCOMING_METHOD_PUT=body      # PUT 只记录 body
# HTTP_LOG_INCOMING_METHOD_PATCH=body
# HTTP_LOG_INCOMING_METHOD_DELETE=headers

# 输出格式（json / text / curl）
HTTP_LOG_INCOMING_FORMAT=json

# 单个 body 最大捕获字节数，超出时截断（0 = 不限制）
HTTP_LOG_INCOMING_MAX_BODY=65536

# 是否同时记录响应体（需克隆 Response，有轻微性能开销，默认关闭）
# 建议仅在排查问题时临时开启
HTTP_LOG_INCOMING_RESPONSE_BODY=false

# 不记录日志的追加排除路径（逗号分隔，追加到内置排除列表之后）
# 内置排除：/api/health, /api/ws, /api/metrics, /docs, /api/ui
# HTTP_LOG_INCOMING_EXCLUDE=/api/files,/api/db-backups

# 是否写入独立的 http-traffic.YYYY-MM-DD.N.log（默认合并进 app.*.log）
# 日志量大时建议开启，避免 app 日志被流量日志淹没
HTTP_LOG_INCOMING_FILE=false

# ── 出站日志 ──────────────────────────────────────────────────────────────────
# 全局开关（默认关闭，按需开启）
HTTP_LOG_OUTGOING_ENABLED=false

# 默认记录级别（出站默认 full，便于排查第三方集成问题）
HTTP_LOG_OUTGOING_LEVEL=full

# 方法级别覆盖
# HTTP_LOG_OUTGOING_METHOD_GET=access    # 常规查询降级
# HTTP_LOG_OUTGOING_METHOD_POST=full

# 输出格式（json / text / curl）
HTTP_LOG_OUTGOING_FORMAT=json

# 单个 body 最大捕获字节数
HTTP_LOG_OUTGOING_MAX_BODY=4096

# 是否记录出站响应体（出站默认开启，便于排查第三方接口返回）
HTTP_LOG_OUTGOING_RESPONSE_BODY=true

# 是否将出站日志写入独立的 http-traffic.*.log（默认合并到 app.*.log）
# HTTP_LOG_OUTGOING_FILE=false

# ─── 支付中心 ─────────────────────────────────────────────────────────────────
# 渠道异步回调基址（渠道配置未显式填 notifyUrl 时拼接使用；沙箱渠道不校验）
# 示例：PAYMENT_NOTIFY_BASE_URL=https://pay.example.com
PAYMENT_NOTIFY_BASE_URL=

# 公开收银台前端基地址；支付宝/微信 H5 同步回跳地址由服务端基于此值构造。
PAYMENT_CASHIER_BASE_URL=http://localhost:5373

# 退款 / 转账审批阈值不再由环境变量提供：在「系统设置 → 支付风控」维护（运行时设置 payment 模块，支持租户级覆盖）。

# 定时对沙箱渠道成功订单自动生成模拟投诉（演示环境用），默认关闭；
# 手动「模拟投诉」按钮不受此开关限制。
PAYMENT_MOCK_DISPUTES=false

# ─── CMS 出站与静态文件安全 ────────────────────────────────────────────────────
# CMS static output root (defaults to storage/cms-static)
CMS_STATIC_ROOT=
# Public hostnames allowed for CMS CDN purge webhooks. Exact names or *.example.com, comma-separated.
# Empty means CDN purge calls are disabled. Private/local/IP destinations are always rejected.
CMS_CDN_PURGE_HOST_ALLOWLIST=
# Optional private-source exceptions for CMS collection only (hostname/IP/CIDR, comma-separated).
CMS_COLLECT_SSRF_ALLOWLIST=

# ─── 开放平台 ─────────────────────────────────────────────────────────────────
# Webhook 回调允许访问的本机/内网主机（hostname / IP / CIDR，逗号分隔）。
# 留空表示一律拒绝内网地址（生产环境保持留空）；开发环境可填 localhost,127.0.0.1
# 以便在本地端到端验证 Webhook 投递链路。
OPEN_WEBHOOK_ALLOWED_HOSTS=

# ─── 工作流 ───────────────────────────────────────────────────────────────────
# 工作流域全部出站请求（远程数据源、连接器、事件订阅、自动化 Webhook、触发器 / 外部审批、补偿动作、
# 节点监听器）都启用 SSRF 防护：保存时与请求时都拒绝本机 / 私网 / 链路本地 / 云元数据地址。
# 确需访问内网服务时在此放行（hostname / *.suffix / IP / CIDR，逗号分隔）；生产环境按需精确列出。
WORKFLOW_OUTBOUND_ALLOWED_HOSTS=