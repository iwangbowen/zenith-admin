      "maxCriticalCssFiles": 4,
      "routes": {
        "AdminLayout": { "maxFiles": 40, "maxGzKB": 450 },
        "DashboardPage": { "maxFiles": 30, "maxGzKB": 420 }
      },
      "authenticatedFirstScreen": { "maxFiles": 60, "maxGzKB": 1000 }
    },
    "member.html": {
      "maxCriticalFiles": 8,
      "maxCriticalGzKB": 270,
      "maxCriticalCssFiles": 4
    },
    "approval.html": {
      "maxCriticalFiles": 8,
      "maxCriticalGzKB": 220,
      "maxCriticalCssFiles": 4
    }
  }
}
